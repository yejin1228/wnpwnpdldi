# 이 파일을 .env.local로 복사하고 키를 넣는다. .env.local은 git에 올리지 않는다.
# 키가 하나도 없으면 AI 판독은 캐시(fixtures/ai-cache.json)로 답한다.

# Gemini (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=
# 비워 두면 gemini-2.5-flash
GEMINI_MODEL=

# 예비: GPT-4o. Gemini가 실패할 때만 쓴다
OPENAI_API_KEY=
OPENAI_MODEL=

# 배포본(Vercel) 전용: 상태를 Upstash Redis에 저장한다. 비워 두면 메모리만 쓴다(로컬 시연은 비워 둘 것).
# Vercel Storage에서 Upstash Redis를 연결하면 자동으로 들어온다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 시연 초기화 주소(POST /api/reset?token=값) 보호용. 비워 두면 누구나 초기화할 수 있다.
RESET_TOKEN=
